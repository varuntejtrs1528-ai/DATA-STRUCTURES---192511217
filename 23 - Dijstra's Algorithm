#include <stdio.h>

#define MAX 20
#define INF 99999

void dijkstra(int graph[MAX][MAX], int n, int start)
{
    int distance[MAX];
    int visited[MAX];
    int i, j, min, next;

    // Initialize
    for (i = 0; i < n; i++)
    {
        distance[i] = graph[start][i];
        visited[i] = 0;
    }

    distance[start] = 0;
    visited[start] = 1;

    // Find shortest paths
    for (i = 1; i < n; i++)
    {
        min = INF;
        next = -1;

        // Find the unvisited vertex with minimum distance
        for (j = 0; j < n; j++)
        {
            if (!visited[j] && distance[j] < min)
            {
                min = distance[j];
                next = j;
            }
        }

        if (next == -1)
            break;

        visited[next] = 1;

        // Update distances
        for (j = 0; j < n; j++)
        {
            if (!visited[j] &&
                graph[next][j] != INF &&
                distance[next] + graph[next][j] < distance[j])
            {
                distance[j] = distance[next] + graph[next][j];
            }
        }
    }

    printf("\nShortest distances from vertex %d:\n", start);

    for (i = 0; i < n; i++)
    {
        if (distance[i] == INF)
            printf("Vertex %d : No path\n", i);
        else
            printf("Vertex %d : %d\n", i, distance[i]);
    }
}

int main()
{
    int graph[MAX][MAX];
    int n, i, j, start;

    printf("Enter the number of vertices: ");
    scanf("%d", &n);

    printf("Enter the cost adjacency matrix:\n");
    printf("Enter 99999 for no direct edge.\n");

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
        {
            scanf("%d", &graph[i][j]);
        }
    }

    printf("Enter the starting vertex: ");
    scanf("%d", &start);

    dijkstra(graph, n, start);

    return 0;
}
